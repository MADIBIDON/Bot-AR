# Copy this file to .env and fill in real values.
# Never commit .env or real secrets to Git.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (added in a later phase) ---
DATABASE_URL=sqlite:///./data/app.db

# --- Discord (added in a later phase) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ALERT_CHANNEL_ID=

# --- Security / spending limits (added in a later phase) ---
AUTHORIZED_DISCORD_USER_IDS=
PURCHASES_ENABLED=false
