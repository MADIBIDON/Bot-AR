# Copy this file to .env and fill in real values.
# Never commit .env or real secrets to Git.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (added in a later phase) ---
DATABASE_URL=sqlite:///./data/app.db

# --- Discord ---
# Create your own private bot at https://discord.com/developers/applications
# See the Phase 9 setup instructions for exact steps and required permissions.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=123456789012345678
DISCORD_ALERT_CHANNEL_ID=123456789012345678

# --- Security / spending limits ---
AUTHORIZED_DISCORD_USER_IDS=

# --- Automated purchase kill switch (Phase 19) ---
# Stays "false" until you have deliberately reviewed the risk. No purchase
# is ever attempted while this is anything other than exactly "true".
PURCHASES_ENABLED=false
# Hard ceiling on any single order, regardless of any WatchRule's own
# max_price — the last line of defense against a misconfigured rule.
PURCHASE_MAX_ORDER_EUR=100
# Hard ceiling on total spend (sum of PURCHASED attempts) per rolling 24h.
PURCHASE_MAX_DAILY_EUR=300
# Comma-separated merchant domains allowed to be auto-purchased from —
# empty means no merchant is allowed, even with PURCHASES_ENABLED=true.
PURCHASE_ALLOWED_MERCHANTS=
# Minimum seconds between purchase attempts for the same listing.
PURCHASE_COOLDOWN_SECONDS=300
